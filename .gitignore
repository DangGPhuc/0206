# 0206 Data & Artifact Exclusions

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.env
*.env
venv/
env/
.venv/
*.egg-info/
build/
dist/
*.zip

# Malware samples & binaries (STRICT: Never commit binaries)
*.exe
*.dll
*.sys
*.bin
*.raw
*.elf
*.dylib
*.so.*
malware_samples/
samples/
case_data/

# Network packet traces & memory dumps (STRICT: Never commit PCAPs or Dumps)
*.pcap
*.pcapng
*.cap
*.dmp
*.mem
*.core

# Logs & Behavioral CSV traces
*.csv
*.evtx
*.log

# Generated analysis outputs & reports
output/
output_reports/
reports/
*.docx
*.pdf

# Cryptographic keys & secrets
*.pem
*.key
*.pkcs12
*.pfx
*.egg-info/
