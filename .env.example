# 0206 Environment Configuration Template
# Copy to .env for local overrides (never commit .env to version control)

# Optional LLM API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Optional LLM Model Configuration
OPENAI_MODEL=gpt-4o
OPENAI_API_BASE=

# Privacy Configuration (strict | standard | none)
AUTOSLEUTH_PRIVACY_MODE=strict

# Optional External Reverse Engineering Tool Executable Paths
AUTOSLEUTH_GHIDRA_PATH=ghidra
AUTOSLEUTH_IDA_PATH=ida64
AUTOSLEUTH_X64DBG_PATH=x64dbg
AUTOSLEUTH_YARA_PATH=yara
AUTOSLEUTH_PESIEVE_PATH=pe-sieve

# Custom Output & Template Directories
AUTOSLEUTH_OUTPUT_DIR=
AUTOSLEUTH_TEMPLATE_PATH=
